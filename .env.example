# Environment Variables — Campus Lost & Found
# Copy this file to .env and fill in your values.
# NEVER commit the actual .env file to version control.

# Flask secret key — change this to a long random string in production
FLASK_SECRET_KEY=change-this-to-a-long-random-string

# Admin passcode for the /admin section
# Default (dev only): admin123
# Change before any real deployment.
ADMIN_PASSCODE=admin123

# Set to 'production' before deploying
FLASK_ENV=development

# Persistent PostgreSQL Database URL (Required for Vercel deployment)
# In Vercel, this is automatically injected when using Vercel Postgres,
# or can be added in Project Settings -> Environment Variables.
# Examples:
# Neon: postgresql://username:password@ep-sample-12345.us-east-2.aws.neon.tech/neondb?sslmode=require
# Supabase: postgresql://postgres:password@db.xxxx.supabase.co:5432/postgres?sslmode=require
DATABASE_URL=postgresql://username:password@hostname:5432/database_name?sslmode=require

